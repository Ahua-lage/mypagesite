---
import GardenPage from "@components/garden/GardenPage.astro";
import { fetchNotes, getCategories, type Note } from "@api/github-notes";

const sortParam = (Astro.params.sort as string) || "newest";
const validSorts = ["newest", "last-edited", "alphabetical"] as const;
const selectedSort = validSorts.includes(sortParam as any)
    ? (sortParam as any)
    : "newest";

const notesData = await fetchNotes();
const allCategories = getCategories(notesData);

const categoryInfoList = allCategories
    .map((cat) => ({
        name: cat,
        count: (notesData[cat] as Note[])?.length || 0,
    }))
    .sort((a, b) => b.count - a.count);

const categoryIndexMap: Record<string, number> = {};
categoryInfoList.forEach((cat, index) => {
    categoryIndexMap[cat.name] = index;
});

const allNotes: Note[] = [];
for (const cat of allCategories) {
    const catNotes = notesData[cat] as Note[];
    if (Array.isArray(catNotes)) {
        allNotes.push(...catNotes);
    }
}

const sortedNotes = [...allNotes].sort((a, b) => {
    if (selectedSort === "newest") {
        return new Date(b.created).getTime() - new Date(a.created).getTime();
    }
    if (selectedSort === "alphabetical") {
        return a.title.localeCompare(b.title);
    }
    return new Date(b.edited).getTime() - new Date(a.edited).getTime();
});
---

<GardenPage
    notes={sortedNotes}
    allCategories={categoryInfoList}
    categoryIndexMap={categoryIndexMap}
    selectedSort={selectedSort}
/>