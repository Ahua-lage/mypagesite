---
import GardenPage from "@components/garden/GardenPage.astro";
import { fetchNotes, getCategories, type Note } from "@api/github-notes";

const categoryParam = Astro.params.category;

const notesData = await fetchNotes();
const allCategories = getCategories(notesData);

const categoryInfoList = allCategories
    .map((cat) => ({
        name: cat,
        count: (notesData[cat] as Note[])?.length || 0,
    }))
    .sort((a, b) => b.count - a.count);

const categoryIndexMap: Record<string, number> = {};
categoryInfoList.forEach((cat, index) => {
    categoryIndexMap[cat.name] = index;
});

function findMatchingCategory(
    param: string | undefined,
    categories: string[],
): string | undefined {
    if (!param) return undefined;
    const p = param.normalize("NFC").toLowerCase();
    const exact = categories.find(
        (c) => c.normalize("NFC").toLowerCase() === p,
    );
    if (exact) return exact;
    return categories.find((c) => {
        const cl = c.normalize("NFC").toLowerCase();
        return cl.includes(p) || p.includes(cl);
    });
}

const resolvedCategory =
    findMatchingCategory(categoryParam, allCategories) || categoryParam;

const categoryNotes = ((notesData[resolvedCategory] as Note[]) || []).sort(
    (a, b) =>
        new Date(b.created).getTime() - new Date(a.created).getTime(),
);
---

<GardenPage
    notes={categoryNotes}
    allCategories={categoryInfoList}
    categoryIndexMap={categoryIndexMap}
    selectedCategory={resolvedCategory}
    selectedSort="newest"
/>