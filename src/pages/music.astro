---
import Layout from "@layouts/Layout.astro";
import HeadlineParagraphSection from "@components/HeadlineParagraphSection.astro";
import Container from "@components/Container.astro";
import Link from "@components/Link.astro";
import AlbumCarousel from "@components/music/AlbumCarousel.astro";
import { fetchTopAlbums, type AlbumDetails } from "@api/lastfm";
import { buildGardenNoteMap } from "@utils/gardenNotes";

let monthlyAlbums: AlbumDetails[] = [];
let yearlyAlbums: AlbumDetails[] = [];
let overallAlbums: AlbumDetails[] = [];
let error = null;

try {
    [monthlyAlbums, yearlyAlbums, overallAlbums] = await Promise.all([
        fetchTopAlbums("1month", 12),
        fetchTopAlbums("12month", 12),
        fetchTopAlbums("overall", 12),
    ]);
} catch (e) {
    console.error("Failed to fetch Last.fm data:", e);
    error = e instanceof Error ? e.message : "Unknown error occurred";
    monthlyAlbums = [];
    yearlyAlbums = [];
    overallAlbums = [];
}

const allAlbumTitles = [
    ...new Set([
        ...monthlyAlbums.map((a) => a.title),
        ...yearlyAlbums.map((a) => a.title),
        ...overallAlbums.map((a) => a.title),
    ]),
];
const gardenNoteMap = await buildGardenNoteMap("Music", allAlbumTitles);
---

<Layout>
    <HeadlineParagraphSection title="音乐" isFirstElement>
        自2013年以来，我一直在 <Link
            href="https://www.last.fm/"
            external>Last.fm</Link
        > 上追踪我的收听习惯。数据从 Last.fm API 拉取并显示在这里，展示我过去一个月、一年和历史上收听最多的专辑。
    </HeadlineParagraphSection>

    {
        error && (
            <Container>
                <div class="bg-red-50 border border-red-200 rounded-lg p-4 mb-8">
                    <p class="text-red-800">
                        加载音乐数据失败: {error}
                    </p>
                </div>
            </Container>
        )
    }

    {
        (monthlyAlbums.length > 0 || yearlyAlbums.length > 0 || overallAlbums.length > 0) && (
            <div class="flex flex-col gap-24">
                <AlbumCarousel title="过去30天" albums={monthlyAlbums} gardenNoteMap={gardenNoteMap} />
                <AlbumCarousel title="过去365天" albums={yearlyAlbums} gardenNoteMap={gardenNoteMap} />
                <AlbumCarousel title="有史以来" albums={overallAlbums} gardenNoteMap={gardenNoteMap} />
            </div>
        )
    }

    {
        monthlyAlbums.length === 0 && yearlyAlbums.length === 0 && overallAlbums.length === 0 && !error && (
            <Container>
                <div class="text-center py-20">
                    <h2 class="text-xl font-medium mb-2">未找到专辑</h2>
                    <p class="text-neutral-600">
                        稍后再来查看音乐更新。
                    </p>
                </div>
            </Container>
        )
    }
</Layout>
