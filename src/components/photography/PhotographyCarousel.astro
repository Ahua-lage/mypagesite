---
import { Image } from "astro:assets";
import Carousel from "../carousel/Carousel.astro";
import CarouselItem from "../carousel/CarouselItem.astro";

import Photo02 from "@assets/landingpage-photos/02.jpg";
import Photo07 from "@assets/landingpage-photos/07.jpg";
import Photo12 from "@assets/landingpage-photos/12.jpg";
import Photo13 from "@assets/landingpage-photos/13.jpg";
import Photo17 from "@assets/landingpage-photos/17.png";

const photos = [
    Photo02,
    Photo07,
    Photo12,
    Photo13,
    Photo17,
];

const headline = "摄影";

const description =
    "初学中，还在进步......";
---

<Carousel
    headline={headline}
    description={description}
    link={{ href: "/photos", text: "查看所有照片 →", external: true }}
>
    {
        photos.map((photo) => (
            <CarouselItem
                largeSpan={4}
                mediumSpan={5}
                smallSpan={10}
                paddingBottom={24}
                paddingTop={24}
            >
                <Image
                    src={photo}
                    alt="摄影"
                    class="bg-neutral-100"
                    loading="lazy"
                    format="webp"
                    quality={80}
                />
            </CarouselItem>
        ))
    }
</Carousel>
