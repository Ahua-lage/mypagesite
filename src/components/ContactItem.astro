---
import { Icon } from "astro-icon/components";

interface Props {
    service: string;
    handle: string;
    url?: string;
    noBorder?: boolean;
    stickerColor: "yellow" | "blue" | "red" | "lilac";
    id: string;
    qrcode?: string;
}

const { service, handle, url, noBorder, stickerColor, id, qrcode } =
    Astro.props as Props;
---

<li id={id} class="contact-item group relative" data-sticker-color={stickerColor}>
    <a
        href={url}
        target="_blank"
        class={`grid grid-cols-4 items-center py-4 sm:grid-cols-6 lg:grid-cols-9 transition-[border-color] ${
            !noBorder && "border-b border-border-dark"
        }`}
    >
        <span
            class="col-start-1 col-end-4 font-bold sm:col-start-1 sm:col-end-3 lg:col-start-1 lg:col-end-4"
            >{service}</span
        >
        <span
            class="col-start-1 col-end-4 font-mono sm:col-start-3 sm:col-end-5 md:col-start-3 md:col-end-7 lg:col-start-4 lg:col-end-9 truncate"
        >
            {handle}
        </span>
        <span
            class="col-start-4 col-end-4 justify-self-end transition group-hover:rotate-45 sm:col-start-5 sm:col-end-7 md:col-start-8 md:col-end-9 lg:col-start-9 lg:col-end-10"
        >
            <Icon name="ph:arrow-up-right-bold" width={16} />
        </span>
    </a>
    {qrcode && (
        <div class="qrcode-container absolute left-full top-0 ml-4 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 z-50">
            <div class="bg-white rounded-xl shadow-xl p-4 border border-border">
                <img
                    src={qrcode}
                    alt={`${service} QR Code`}
                    class="w-48 h-48 object-contain"
                />
                <p class="text-xs text-center mt-2 text-muted">扫码添加</p>
            </div>
        </div>
    )}
</li>